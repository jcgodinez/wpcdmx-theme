{
	"$schema": "https://schemas.wp.org/wp/6.9/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "crema", "name": "Crema (fondo)", "color": "#FBF7EF" },
				{ "slug": "blanco", "name": "Blanco", "color": "#FFFFFF" },
				{ "slug": "grafito", "name": "Grafito (texto)", "color": "#32373C" },
				{ "slug": "tinta-suave", "name": "Texto secundario", "color": "#5A6066" },
				{ "slug": "linea", "name": "Línea", "color": "#E8DFCF" },
				{ "slug": "turquesa", "name": "Turquesa", "color": "#0097AF" },
				{ "slug": "turquesa-oscuro", "name": "Turquesa oscuro (enlaces)", "color": "#007A8C" },
				{ "slug": "amarillo", "name": "Amarillo", "color": "#F0A400" },
				{ "slug": "verde", "name": "Verde", "color": "#799B13" },
				{ "slug": "rojo", "name": "Rojo", "color": "#DF0026" },
				{ "slug": "gris-claro", "name": "Gris claro (texto sobre grafito)", "color": "#C5C9CD" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1 · 8px", "size": "8px" },
				{ "slug": "20", "name": "2 · 16px", "size": "16px" },
				{ "slug": "30", "name": "3 · 24px", "size": "24px" },
				{ "slug": "40", "name": "4 · 32px", "size": "clamp(24px, 3vw, 32px)" },
				{ "slug": "50", "name": "5 · 48px", "size": "clamp(32px, 4vw, 48px)" },
				{ "slug": "60", "name": "6 · 80px", "size": "clamp(56px, 6vw, 80px)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "rubik",
					"name": "Rubik",
					"fontFamily": "\"Rubik\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Rubik",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Rubik-VariableFont_wght.woff2" ]
						},
						{
							"fontFamily": "Rubik",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/Rubik-Italic-VariableFont_wght.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "Etiqueta · 13px", "size": "13px", "fluid": false },
				{ "slug": "small", "name": "Chico · 15px", "size": "15px", "fluid": false },
				{ "slug": "medium", "name": "Texto · 18px", "size": "18px", "fluid": false },
				{ "slug": "large", "name": "Entradilla · 20px", "size": "20px", "fluid": { "min": "18px", "max": "20px" } },
				{ "slug": "x-large", "name": "H3 · 24px", "size": "24px", "fluid": { "min": "20px", "max": "24px" } },
				{ "slug": "xx-large", "name": "H2 · 32px", "size": "32px", "fluid": { "min": "26px", "max": "32px" } },
				{ "slug": "huge", "name": "H1 · 44px", "size": "44px", "fluid": { "min": "30px", "max": "44px" } },
				{ "slug": "gigantic", "name": "Display · 64px", "size": "64px", "fluid": { "min": "40px", "max": "64px" } }
			]
		},
		"custom": {
			"radius": {
				"chico": "6px",
				"medio": "12px",
				"grande": "24px",
				"pildora": "999px"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|crema",
			"text": "var:preset|color|grafito"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|rubik",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|30",
			"padding": {
				"left": "var:preset|spacing|40",
				"right": "var:preset|spacing|40"
			}
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|turquesa-oscuro" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var:preset|color|grafito" } }
			},
			"heading": {
				"typography": { "fontWeight": "700", "lineHeight": "1.2" },
				"color": { "text": "var:preset|color|grafito" }
			},
			"h1": { "typography": { "fontSize": "var:preset|font-size|huge", "lineHeight": "1.15" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|xx-large", "lineHeight": "1.25" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|x-large", "fontWeight": "500", "lineHeight": "1.33" } },
			"h4": { "typography": { "fontSize": "var:preset|font-size|large", "fontWeight": "500" } },
			"button": {
				"color": {
					"background": "var:preset|color|rojo",
					"text": "var:preset|color|blanco"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": { "top": "14px", "bottom": "14px", "left": "28px", "right": "28px" }
				},
				"typography": { "fontSize": "var:preset|font-size|medium", "fontWeight": "500", "lineHeight": "1.4" },
				":hover": {
					"color": {
						"background": "var:preset|color|grafito",
						"text": "var:preset|color|blanco"
					}
				}
			},
			"caption": {
				"typography": { "fontSize": "var:preset|font-size|small" },
				"color": { "text": "var:preset|color|tinta-suave" }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "17px", "fontWeight": "500" },
				"elements": {
					"link": {
						"typography": { "textDecoration": "none" },
						"color": { "text": "var:preset|color|grafito" },
						":hover": { "color": { "text": "var:preset|color|rojo" } }
					}
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|linea" }
			},
			"core/post-date": {
				"color": { "text": "var:preset|color|tinta-suave" },
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/post-terms": {
				"typography": { "fontSize": "var:preset|font-size|small" }
			},
			"core/quote": {
				"border": { "left": { "color": "var:preset|color|amarillo", "width": "4px" } },
				"spacing": { "padding": { "left": "var:preset|spacing|30" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Encabezado", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	]
}
